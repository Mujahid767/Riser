// Riser E-commerce Platform — Prisma Schema
// Phase 2: PostgreSQL-backed products, variants, inventory and orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?       @db.Text
  fabric           String?

  // Category / department (Riser's flat taxonomy)
  category         String?       // "baby-frock", "two-piece-kids", etc.
  department       String?       // "petite" | "women"

  // Pricing
  basePrice        Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)

  // Images — primary + secondary stored flat for fast reads
  imageUrl         String        @default("")
  secondaryImageUrl String?
  // Additional gallery images as JSON array of URLs
  galleryImages    Json          @default("[]")

  // Variants stored as JSON arrays for simple admin CRUD
  // Each color: { name: string, value: string }
  colors           Json          @default("[]")
  // Each size: string
  sizes            Json          @default("[]")

  // Badges
  editionBadge     String?
  isNew            Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  isOnSale         Boolean       @default(false)
  isLimited        Boolean       @default(false)

  // Tags
  tags             String[]      @default([])

  // Status
  status           ProductStatus @default(DRAFT)

  // Simple total stock (sum of all variants)
  stock            Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orderItems    OrderItem[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([department])
  @@index([isBestSeller])
  @@index([isNew])
  @@map("products")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique // RIS-2026-000123

  // Customer info (snapshot at order time)
  customerName     String
  customerPhone    String
  customerEmail    String?

  // Shipping address
  address          String        // full address line
  district         String        // from DISTRICTS list in lib/shipping.ts

  // Pricing
  subtotal         Decimal       @db.Decimal(10, 2)
  shippingAmount   Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount   Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(10, 2)

  // Payment
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)

  // Status
  status           OrderStatus   @default(PENDING)

  // Notes
  customerNotes    String?
  adminNotes       String?

  // Staff fields
  trackingNumber   String?
  idempotencyKey   String?       @unique
  // JSON array of flag strings, e.g. ["repeat_phone_24h"]
  flags            Json          @default("[]")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            OrderItem[]

  @@index([orderNumber])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?  // nullable — product may be deleted

  // Snapshot of product data at order time
  productName String
  imageUrl    String?
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
