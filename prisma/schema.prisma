// Riser E-commerce Platform — Prisma Schema
// Phase 2: PostgreSQL-backed products, variants, inventory and orders.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?       @db.Text
  fabric           String?

  // Category / department (Riser's flat taxonomy)
  category         String?       // "baby-frock", "two-piece-kids", etc.
  department       String?       // "petite" | "women"

  // Pricing
  basePrice        Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @db.Decimal(10, 2)

  // Images — primary + secondary stored flat for fast reads
  imageUrl         String        @default("")
  secondaryImageUrl String?
  // Additional gallery images as JSON array of URLs
  galleryImages    Json          @default("[]")

  // Variants stored as JSON arrays for simple admin CRUD
  // Each color: { name: string, value: string }
  colors           Json          @default("[]")
  // Each size: string
  sizes            Json          @default("[]")
  // Optional price override per size: Record<string, number> e.g. { "16-20": 650, "22-26": 750 }
  sizePrices       Json          @default("{}")
  // Optional inventory per size: Record<string, number> e.g. { "16-20": 4, "22-26": 1 }
  sizeStock        Json          @default("{}")

  // Badges
  editionBadge     String?
  isNew            Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  isFeatured       Boolean       @default(false)
  isOnSale         Boolean       @default(false)
  isLimited        Boolean       @default(false)

  // Tags
  tags             String[]      @default([])

  // Status
  status           ProductStatus @default(DRAFT)

  // Simple total stock (sum of all variants)
  stock            Int           @default(0)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  orderItems    OrderItem[]
  reviews       Review[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([department])
  @@index([isBestSeller])
  @@index([isNew])
  @@map("products")
}

// ─────────────────────────────────────────────
// ORDERS
// ─────────────────────────────────────────────

model Order {
  id               String        @id @default(cuid())
  orderNumber      String        @unique // RIS-2026-000123

  // Customer info (snapshot at order time)
  customerName     String
  customerPhone    String
  customerEmail    String?

  // Shipping address
  address          String        // full address line
  district         String        // from DISTRICTS list in lib/shipping.ts

  // Pricing
  subtotal         Decimal       @db.Decimal(10, 2)
  shippingAmount   Decimal       @db.Decimal(10, 2) @default(0)
  discountAmount   Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount      Decimal       @db.Decimal(10, 2)

  // Payment
  paymentMethod    PaymentMethod @default(COD)
  paymentStatus    PaymentStatus @default(PENDING)

  // Status
  status           OrderStatus   @default(PENDING)

  // Notes
  customerNotes    String?
  adminNotes       String?

  // Staff fields
  trackingNumber   String?

  // Courier (Steadfast) consignment created from the admin panel
  courierProvider     String?
  courierConsignmentId String?
  courierTrackingCode String?
  courierStatus       String?
  courierSentAt       DateTime?

  idempotencyKey   String?       @unique
  // JSON array of flag strings, e.g. ["repeat_phone_24h"]
  flags            Json          @default("[]")

  // Meta browser/click IDs captured at checkout when present (unhashed)
  fbp              String?
  fbc              String?

  // Verified milestone timestamps for historical CAPI retries & original event_time
  confirmedAt      DateTime?
  deliveredAt      DateTime?
  paidAt           DateTime?

  // Admin-controlled flag to keep test orders & tracking logs without inflating KPIs
  isTest           Boolean       @default(false)

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            OrderItem[]
  reviews          Review[]
  trackingEvents   TrackingEvent[]

  @@index([orderNumber])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([isTest])
  @@index([createdAt])
  @@index([idempotencyKey])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String?  // nullable — product may be deleted

  // Snapshot of product data at order time
  productName String
  imageUrl    String?
  size        String?
  color       String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)

  createdAt   DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderCounter {
  year      Int @id
  lastValue Int @default(0)

  @@map("order_counters")
}

enum TrackingEventStatus {
  PENDING
  SENT
  FAILED
  EXPIRED
}

model TrackingEvent {
  id            String              @id @default(cuid())
  orderId       String
  orderNumber   String
  eventName     String              // "CODOrderPlaced" | "QualifiedOrder" | "Purchase"
  eventId       String              // Stable deduplication ID, e.g. "pur-RIS-2026-000001"
  eventTime     Int?                // Original Unix seconds when the business event occurred
  status        TrackingEventStatus @default(PENDING)
  attempts      Int                 @default(0)
  lastError     String?
  payload       Json?
  lastAttemptAt DateTime?
  nextRetryAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, eventName])
  @@index([status, nextRetryAt])
  @@index([createdAt])
  @@map("tracking_events")
}

// ─────────────────────────────────────────────
// CMS & DYNAMIC SITE CONTENT
// ─────────────────────────────────────────────

model CmsContent {
  id        String   @id @default("site_content")
  data      Json
  updatedAt DateTime @updatedAt

  @@map("cms_content")
}

model MediaItem {
  id        String   @id
  url       String
  filename  String
  width     Int      @default(0)
  height    Int      @default(0)
  bytes     Int      @default(0)
  storage   String   @default("local")
  publicId  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("media_items")
}

// ─────────────────────────────────────────────
// COURIER SETTINGS (single row per provider, e.g. "steadfast")
// Secrets are stored AES-256-GCM encrypted (see lib/courier/crypto.ts).
// ─────────────────────────────────────────────

model CourierSettings {
  id             String   @id // provider key, e.g. "steadfast"
  email          String?
  passwordEnc    String?
  apiKeyEnc      String?
  secretKeyEnc   String?
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("courier_settings")
}

// ─────────────────────────────────────────────
// MARKETING & SEO SETTINGS
// ─────────────────────────────────────────────

model MarketingSettings {
  id                         String   @id @default("default")
  gtmId                      String?  // Google Tag Manager ID (GTM-XXXXXX)
  ga4Id                      String?  // GA4 Measurement ID (G-XXXXXX)
  metaPixelId                String?  // Meta Pixel ID
  metaCapiTokenEnc           String?  // Meta CAPI Access Token (Encrypted)
  metaTestEventCode          String?  // Meta Test Event Code (e.g. TEST12345)
  googleSiteVerification     String?  // Google Search Console meta tag content
  facebookDomainVerification String?  // Meta Domain Verification meta tag content
  purchaseEventTrigger       String   @default("ORDER_PLACED") // "ORDER_PLACED" | "ORDER_DELIVERED"
  enableAdvancedMatching     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@map("marketing_settings")
}


// ─────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id           String     @id @default(cuid())
  code         String     @unique // e.g. "EID30"
  type         CouponType @default(PERCENT)
  value        Decimal    @db.Decimal(10, 2) // 30 = 30% or ৳30
  minOrderAmount Decimal? @db.Decimal(10, 2) // minimum cart total to apply
  maxUses      Int?       // null = unlimited
  usedCount    Int        @default(0)
  expiresAt    DateTime?
  active       Boolean    @default(true)
  description  String?    // admin note

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([code])
  @@index([active])
  @@map("coupons")
}

// ─────────────────────────────────────────────
// REVIEWS
// ─────────────────────────────────────────────

model Review {
  id        String   @id @default(cuid())
  productId String
  orderId   String?  // link to the order (optional for data integrity)
  rating    Int      // 1-5
  comment   String?  @db.Text
  name      String   // display name
  approved  Boolean  @default(false) // admin approves before showing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([orderId])
  @@index([approved])
  @@map("reviews")
}
